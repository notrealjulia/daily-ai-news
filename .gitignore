# Environment / secrets
.venv/
.env

# Local database (SQLite also creates -wal/-shm files in WAL mode)
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/

# Streamlit secrets (the hosted dashboard's Turso settings live here)
.streamlit/secrets.toml

# audio/*.mp3 is deliberately NOT ignored: the daily GitHub Actions run commits the
# narration files here, and the deployed Streamlit app reads them straight from the repo
# checkout (see the workflow's "Commit and push" step and README's Deployment section).
