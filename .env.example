# Copy to .env and fill in. .env is gitignored; this file is committed.
OPENAI_API_KEY=

# Only for the hosted Turso database: GitHub Actions (the daily pipeline, and the data
# snapshot the dashboard deploy takes) reads it, as do local runs started with
# AINEWS_BACKEND=turso in the real environment (deliberately not read from this file;
# without it, everything uses the local ainews.db). Reading, as the dashboard's server
# does, only needs a read-only token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Text-to-speech for the narration pipeline (ainews narrate).
ELEVENLABS_API_KEY=
