# Copy to .env and fill in. .env is gitignored; this file is committed.
OPENAI_API_KEY=

# Only for the hosted Turso database (GitHub Actions, a hosted dashboard). Leave these
# empty locally: the app uses the local ainews.db unless AINEWS_BACKEND=turso is set in
# the real environment (deliberately not read from this file). For a dashboard, use a
# read-only token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Text-to-speech for the narration pipeline (ainews narrate).
ELEVENLABS_API_KEY=
